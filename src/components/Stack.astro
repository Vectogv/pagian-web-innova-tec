---
// Lo que recibes: un panel de ejemplo (software a medida visto por el dueño del negocio) + entregables en lenguaje claro.
// Las cifras del panel son de ejemplo y se marcan como tal.
const deliverables = [
  ["Tu propio panel", "Pedidos, clientes, inventario y reportes en un solo lugar, desde el computador o el celular."],
  ["Automatizaciones funcionando", "Las tareas repetitivas se hacen solas, todos los días, sin depender de nadie."],
  ["Capacitación para tu equipo", "Les enseñamos a usarlo en una sesión, con un manual sencillo."],
  ["Soporte cuando lo necesites", "Si algo cambia en tu negocio, lo ajustamos contigo."],
];
const kpis = [["Pedidos hoy", "48"], ["Respondidos", "100%"], ["Facturas enviadas", "36"]];
const bars = [38, 52, 44, 61, 57, 72, 66]; // altura relativa de cada día
const days = ["L", "M", "M", "J", "V", "S", "D"];
const orders = [
  ["Laura Gómez", "2 almuerzos ejecutivos", "Entregado"],
  ["Tienda El Sol", "Reposición de inventario", "En camino"],
  ["Carlos Ruiz", "Cita · jueves 10:00", "Confirmada"],
];
---
<section class="panel-sec" id="panel" aria-labelledby="panel-title">
  <div class="wrap">
    <div class="panel-grid">
      <div class="panel-text">
        <span class="eyebrow">Software a tu medida</span>
        <h2 id="panel-title">Además de automatizar, te entregamos tu propio sistema</h2>
        <p class="muted">Construimos la herramienta que tú y tu equipo usan cada día, pensada para cómo trabaja tu negocio y no al revés.</p>
        <dl class="caps">
          {deliverables.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>

      <figure class="app" aria-label="Ejemplo de un panel de negocio hecho a medida">
        <div class="app-bar"><b>Panel · Tu negocio</b><span class="label">Ejemplo</span></div>
        <div class="app-body">
          <ul class="app-nav" aria-hidden="true">
            <li class="on">Inicio</li><li>Pedidos</li><li>Clientes</li><li>Inventario</li><li>Reportes</li>
          </ul>
          <div class="app-main">
            <div class="app-kpis">
              {kpis.map(([k, v]) => <div><span>{k}</span><b>{v}</b></div>)}
            </div>
            <div class="app-chart">
              <span>Ventas de la semana</span>
              <div class="bars" aria-hidden="true">
                {bars.map((h, i) => <i style={`--h:${h}%`}><em>{days[i]}</em></i>)}
              </div>
            </div>
            <ul class="app-list">
              {orders.map(([who, what, state]) => <li><b>{who}</b><span>{what}</span><em>{state}</em></li>)}
            </ul>
          </div>
        </div>
      </figure>
    </div>
    <p class="tech">Trabajamos con herramientas profesionales y probadas, como <b>n8n</b>, bases de datos seguras y servidores en la nube. Tú no tienes que preocuparte por eso.</p>
  </div>
</section>
