---
// Stack: demuestra que hacemos software de verdad. Código de un paso real del flujo de ventas + capacidades y tecnologías.
const capabilities = [
  ["Automatizaciones", "Flujos en n8n con manejo de errores, reintentos y monitoreo."],
  ["APIs e integraciones", "Webhooks y conectores propios cuando una app no trae integración."],
  ["Software a medida", "Paneles, inventarios y herramientas internas en web."],
  ["Datos", "Bases de datos ordenadas y reportes que se generan solos."],
  ["Despliegue y soporte", "En tu servidor o en la nube, con mantenimiento mensual."],
];
const tech = ["n8n", "Node.js", "TypeScript", "Python", "PostgreSQL", "REST y webhooks", "Docker", "Astro", "React"];

// Resaltado de sintaxis hecho a mano (sin librerías): k = palabra clave, f = función, s = texto, c = comentario
const code = [
  `<span class="c">// Paso del flujo de ventas: llega un mensaje por WhatsApp</span>`,
  `<span class="k">export async function</span> <span class="f">alRecibirMensaje</span>(msg) {`,
  `  <span class="k">const</span> tipo = <span class="f">clasificar</span>(msg.texto);   <span class="c">// cotización | soporte | otro</span>`,
  ``,
  `  <span class="k">const</span> cliente = <span class="k">await</span> sheets.<span class="f">agregarFila</span>({`,
  `    nombre: msg.remitente,`,
  `    telefono: msg.telefono,`,
  `    tipo,`,
  `  });`,
  ``,
  `  <span class="k">if</span> (tipo === <span class="s">"cotización"</span>) {`,
  `    <span class="k">await</span> gmail.<span class="f">enviar</span>(<span class="s">"ventas@tuempresa.com"</span>, <span class="f">resumen</span>(cliente));`,
  `  }`,
  ``,
  `  <span class="k">return</span> <span class="f">responder</span>(msg, <span class="s">"¡Recibido! Te escribimos en minutos."</span>);`,
  `}`,
];
---
<section class="stack" id="stack" aria-labelledby="stack-title">
  <div class="wrap">
    <div class="stack-grid">
      <div class="stack-text">
        <span class="path-tag">innova-tec / <b>stack</b></span>
        <h2 id="stack-title">Software de verdad, no solo plantillas</h2>
        <p class="muted">Cuando una herramienta no alcanza, escribimos el código. Cada flujo queda documentado y es tuyo.</p>
        <dl class="caps">
          {capabilities.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      <figure class="code-window" aria-label="Ejemplo de código de un paso del flujo de ventas">
        <div class="code-bar"><span>flujo-ventas / al-recibir-mensaje.ts</span><span class="label">TypeScript</span></div>
        <pre><code>{code.map((line, i) => <span class="code-line"><span class="ln" aria-hidden="true">{i + 1}</span><span set:html={line || " "} /></span>)}</code></pre>
      </figure>
    </div>
    <p class="tech"><span class="label">Tecnologías</span> {tech.join(" / ")}</p>
  </div>
</section>
