<header class="hero">
  <canvas id="graph" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="hero-copy">
      <span class="label">Automatización · IA · Software a medida</span>
      <h1>Las tareas repetitivas de tu negocio, resueltas por flujos que trabajan solos.</h1>
      <p>Conectamos tus herramientas con n8n, creamos asistentes con IA y desarrollamos el software que tu operación necesita. Tú defines el proceso; nosotros lo automatizamos.</p>
      <div class="actions">
        <a href="#contacto" class="btn btn-primary">Agendar diagnóstico gratuito</a>
        <a href="#casos" class="btn btn-secondary">Ver casos de uso</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Grafo 3D de flujos: nodos por capas (disparador → IA → apps → avisos) y pulsos que recorren
  // las conexiones capa por capa, como una ejecución de n8n.
  import * as THREE from "three";

  const canvas = document.getElementById("graph") as HTMLCanvasElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  try {
    init();
  } catch {
    canvas.remove(); // sin WebGL la página se ve igual, solo sin fondo
  }

  function init() {
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0xffffff, 11, 20);
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    camera.position.z = 14;
    const graph = new THREE.Group();
    scene.add(graph);

    const xs = [-4.5, -1.5, 1.5, 4.5];
    const layers = [
      [[0, 0]],
      [[2, -1], [-2, 1]],
      [[3, 1], [0.3, -1.5], [-2.8, 0.5]],
      [[3.8, -1], [1.6, 0.8], [-0.9, -1], [-3.3, 1.5]],
    ].map((l, i) => l.map(([y, z]) => new THREE.Vector3(xs[i], y, z)));

    const nodeGeo = new THREE.BoxGeometry(0.9, 0.9, 0.3);
    const edgeGeo = new THREE.EdgesGeometry(nodeGeo);
    const fillMat = new THREE.MeshBasicMaterial();
    const outlineMat = new THREE.LineBasicMaterial();
    const lineMat = new THREE.LineBasicMaterial({ transparent: true, opacity: 0.7 });
    const pulseMat = new THREE.MeshBasicMaterial();
    const pulseGeo = new THREE.SphereGeometry(0.09, 12, 12);

    layers.flat().forEach((p) => {
      const box = new THREE.Mesh(nodeGeo, fillMat);
      box.position.copy(p);
      box.add(new THREE.LineSegments(edgeGeo, outlineMat));
      graph.add(box);
    });

    // Conexiones entre capas vecinas cuando están cerca en altura; curvas horizontales estilo n8n
    const pulses: { curve: THREE.CubicBezierCurve3; mesh: THREE.Mesh; layer: number }[] = [];
    layers.slice(0, -1).forEach((from, i) => {
      from.forEach((a) =>
        layers[i + 1].forEach((b) => {
          if (Math.abs(a.y - b.y) > 3.6) return;
          const curve = new THREE.CubicBezierCurve3(
            a.clone().setX(a.x + 0.45),
            a.clone().setX(a.x + 1.6),
            b.clone().setX(b.x - 1.6),
            b.clone().setX(b.x - 0.45),
          );
          graph.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(curve.getPoints(40)), lineMat));
          const mesh = new THREE.Mesh(pulseGeo, pulseMat);
          mesh.visible = false;
          graph.add(mesh);
          pulses.push({ curve, mesh, layer: i });
        }),
      );
    });

    const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const applyColors = () => {
      fillMat.color.set(css("--surface"));
      outlineMat.color.set(css("--primary"));
      lineMat.color.set(css("--text-2"));
      pulseMat.color.set(css("--signal"));
      (scene.fog as THREE.Fog).color.set(css("--bg"));
      if (reduce) render(0);
    };

    const mouse = { x: 0, y: 0 };
    addEventListener("pointermove", (e) => {
      mouse.x = (e.clientX / innerWidth - 0.5) * 2;
      mouse.y = (e.clientY / innerHeight - 0.5) * 2;
    });

    function render(t: number) {
      graph.rotation.y = Math.sin(t * 0.12) * 0.45 + mouse.x * 0.12;
      graph.rotation.x = mouse.y * 0.08;
      const cycle = (t * 0.6) % (layers.length + 1); // un tramo por capa y una pausa al final
      pulses.forEach((p) => {
        const k = cycle - p.layer;
        p.mesh.visible = k >= 0 && k < 1;
        if (p.mesh.visible) p.mesh.position.copy(p.curve.getPoint(k));
      });
      renderer.render(scene, camera);
    }

    let running = false;
    const clock = new THREE.Clock();
    const loop = () => {
      if (!running) return;
      render(clock.getElapsedTime());
      requestAnimationFrame(loop);
    };

    new ResizeObserver(() => {
      const { clientWidth: w, clientHeight: h } = canvas;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      graph.position.x = w > 900 ? 3.6 : 0;
      if (reduce) render(0);
    }).observe(canvas);

    new IntersectionObserver(([entry]) => {
      running = entry.isIntersecting && !reduce;
      if (running) loop();
    }).observe(canvas);

    applyColors();
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyColors);
    new MutationObserver(applyColors).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
