<!-- Sala de control: el titular y, debajo, una consola con el flujo en vivo (grafo 3D) y su registro de ejecución -->
<header class="hero">
  <div class="wrap">
    <div class="hero-top">
      <h1 class="hero-title">
        <span>Automatizamos tu operación.</span>
        <span class="accent">Construimos tu software.</span>
      </h1>
      <div class="hero-side">
        <p>Para pequeñas y medianas empresas que quieren dejar el trabajo repetitivo y crecer con tecnología propia: flujos con n8n, integraciones y software a medida.</p>
        <div class="actions">
          <a href="/contacto" class="btn btn-primary">Agendar diagnóstico gratuito</a>
          <a href="#stack" class="btn btn-tertiary">Ver cómo lo construimos</a>
        </div>
      </div>
    </div>

    <div class="console" role="img" aria-label="Simulación de un flujo de automatización ejecutándose: un mensaje entra, se clasifica, se guarda, se factura y se avisa a ventas">
      <div class="console-bar">
        <div class="console-tabs">
          <span class="on">flujo-ventas</span>
          <span>facturación</span>
          <span>agenda</span>
        </div>
        <span class="console-state">Activo · simulación</span>
      </div>
      <div class="console-body">
        <div class="hero-graph">
          <canvas id="graph" aria-hidden="true"></canvas>
          <div class="graph-labels" aria-hidden="true"></div>
        </div>
        <div class="console-log">
          <span class="label">Registro de ejecución</span>
          <ol id="exec-log" aria-hidden="true">
            <li><time>09:14:02</time><span>Nuevo mensaje</span><b>ok</b></li>
            <li><time>09:14:02</time><span>Clasificar</span><b>ok</b></li>
            <li><time>09:14:03</time><span>Guardar en Sheets</span><b>ok</b></li>
            <li><time>09:14:03</time><span>Crear factura</span><b>ok</b></li>
            <li><time>09:14:04</time><span>Avisar a ventas</span><b>ok</b></li>
          </ol>
        </div>
      </div>
      <div class="console-foot">
        <span>n8n · 10 nodos · 4 capas</span>
        <span>Sin intervención manual</span>
      </div>
    </div>
  </div>
</header>

<script>
  // Grafo 3D de flujos: nodos por capas (disparador → reglas → apps → avisos). Cada nodo es un punto de luz
  // con anillo y halo; los pulsos recorren las conexiones capa por capa y encienden el nodo al que llegan.
  import * as THREE from "three";

  const canvas = document.getElementById("graph") as HTMLCanvasElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  try {
    init();
  } catch {
    canvas.remove(); // sin WebGL la página se ve igual, solo sin el grafo
  }

  function glowTexture() {
    const c = document.createElement("canvas");
    c.width = c.height = 64;
    const g = c.getContext("2d")!;
    const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, "rgba(255,255,255,1)");
    grad.addColorStop(0.35, "rgba(255,255,255,.35)");
    grad.addColorStop(1, "rgba(255,255,255,0)");
    g.fillStyle = grad;
    g.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  }

  function init() {
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0xffffff, 11, 20);
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    camera.position.z = 14;
    const graph = new THREE.Group();
    scene.add(graph);

    const glow = glowTexture();
    const coreMat = new THREE.MeshBasicMaterial();
    const ringMat = new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.55, side: THREE.DoubleSide });
    const tubeMat = new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.28 });
    const pulseColor = new THREE.Color();
    const nodeColor = new THREE.Color();

    // Nombre de la tarea de cada nodo, en el mismo orden que `layout`; las marcadas con * se muestran también en celular
    const names = [
      ["*Nuevo mensaje"],
      ["Clasificar", "Responder al cliente"],
      ["Guardar en Sheets", "*Crear factura", "Agendar cita"],
      ["Reporte del día", "*Avisar a ventas", "Enviar recordatorio", "Actualizar inventario"],
    ];
    const labelBox = canvas.parentElement!.querySelector(".graph-labels") as HTMLElement;

    // Registro de ejecución: cada tarea que se enciende en el grafo se escribe con la hora real (máx. 7 líneas)
    const logList = document.getElementById("exec-log");
    const log = (task: string) => {
      if (!logList || reduce) return;
      const li = document.createElement("li");
      const time = new Date().toLocaleTimeString("es", { hour12: false });
      li.innerHTML = `<time>${time}</time><span></span><b>ok</b>`;
      li.querySelector("span")!.textContent = task;
      logList.append(li);
      while (logList.children.length > 7) logList.firstElementChild!.remove();
    };

    const xs = [-4.5, -1.5, 1.5, 4.5];
    const layout = [
      [[0, 0]],
      [[2, -1], [-2, 1]],
      [[3, 1], [0.3, -1.5], [-2.8, 0.5]],
      [[3.8, -1], [1.6, 0.8], [-0.9, -1], [-3.3, 1.5]],
    ];

    type Node = { pos: THREE.Vector3; ring: THREE.Mesh; halo: THREE.Sprite; size: number; flash: number; label: HTMLSpanElement };
    const coreGeo = new THREE.SphereGeometry(0.13, 24, 24);
    const ringGeo = new THREE.RingGeometry(0.3, 0.335, 64);
    const layers: Node[][] = layout.map((l, i) =>
      l.map(([y, z], j) => {
        const pos = new THREE.Vector3(xs[i], y, z);
        const size = i === 0 ? 1.5 : 1;
        const core = new THREE.Mesh(coreGeo, coreMat);
        core.position.copy(pos);
        core.scale.setScalar(size);
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.position.copy(pos);
        ring.scale.setScalar(size);
        const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: glow, transparent: true, depthWrite: false, opacity: 0.25 }));
        halo.position.copy(pos);
        halo.scale.setScalar(1.4 * size);
        graph.add(core, ring, halo);
        const label = document.createElement("span");
        const name = names[i][j];
        label.textContent = name.replace("*", "");
        if (name.startsWith("*")) label.className = "key";
        labelBox.append(label);
        return { pos, ring, halo, size, flash: 0, label };
      }),
    );

    // Conexiones entre capas vecinas cuando están cerca en altura; curvas horizontales estilo n8n
    const TRAIL = 7;
    type Pulse = { curve: THREE.CubicBezierCurve3; sprites: THREE.Sprite[]; layer: number; target: Node };
    const pulses: Pulse[] = [];
    layers.slice(0, -1).forEach((from, i) => {
      from.forEach((a) =>
        layers[i + 1].forEach((b) => {
          if (Math.abs(a.pos.y - b.pos.y) > 3.6) return;
          const curve = new THREE.CubicBezierCurve3(
            a.pos.clone(),
            a.pos.clone().setX(a.pos.x + 1.4),
            b.pos.clone().setX(b.pos.x - 1.4),
            b.pos.clone(),
          );
          graph.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 64, 0.014, 6), tubeMat));
          const sprites = Array.from({ length: TRAIL }, (_, k) => {
            const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: glow, color: pulseColor, transparent: true, depthWrite: false, opacity: 1 - k / TRAIL }));
            s.scale.setScalar(0.55 * (1 - k / (TRAIL + 2)));
            s.visible = false;
            graph.add(s);
            return s;
          });
          pulses.push({ curve, sprites, layer: i, target: b });
        }),
      );
    });

    const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const applyColors = () => {
      nodeColor.set(css("--primary"));
      pulseColor.set(css("--signal"));
      coreMat.color.copy(nodeColor);
      ringMat.color.copy(nodeColor);
      tubeMat.color.set(css("--text-2"));
      layers.flat().forEach((n) => n.halo.material.color.copy(nodeColor));
      pulses.forEach((p) => p.sprites.forEach((s) => s.material.color.copy(pulseColor)));
      (scene.fog as THREE.Fog).color.set(css("--surface")); // el grafo vive dentro del panel de la consola
      if (reduce) render(0, 0);
    };

    graph.rotation.x = 0.12;
    const SPEED = 0.55;

    function render(t: number, dt: number) {
      graph.rotation.y = Math.sin(t * 0.12) * 0.35;
      const cycle = (t * SPEED) % (layers.length + 0.6); // un tramo por capa y una pausa breve al final
      pulses.forEach((p) => {
        const k = cycle - p.layer;
        p.sprites.forEach((s, i) => {
          const ki = k - i * 0.035;
          s.visible = ki >= 0 && ki <= 1;
          if (s.visible) s.position.copy(p.curve.getPoint(ki));
        });
        if (k >= 0.97 && k < 1.03) p.target.flash = 1; // la señal llegó al nodo
      });
      layers[0][0].flash = cycle < 0.1 ? 1 : layers[0][0].flash; // el disparador se enciende al iniciar el ciclo
      layers.flat().forEach((n) => {
        n.flash = Math.max(0, n.flash - dt * 1.6);
        n.halo.material.opacity = 0.22 + n.flash * 0.6;
        n.ring.scale.setScalar(n.size * (1 + n.flash * 0.45));
        n.ring.lookAt(camera.position);
      });
      renderer.render(scene, camera);
      // etiquetas HTML: proyectar cada nodo a la pantalla y encender la tarea cuando la señal llega
      const w = canvas.clientWidth, h = canvas.clientHeight;
      layers.flat().forEach((n) => {
        const v = n.pos.clone().applyMatrix4(graph.matrixWorld).project(camera);
        const half = n.label.offsetWidth / 2;
        const x = Math.min(Math.max(((v.x + 1) / 2) * w, half + 4), w - half - 4); // que no se corte en los bordes
        n.label.style.transform = `translate(${x}px, ${((1 - v.y) / 2) * h}px) translate(-50%, 18px)`;
        const on = n.flash > 0.35;
        if (on && !n.label.classList.contains("on")) log(n.label.textContent!); // la señal llegó: se registra la ejecución
        n.label.classList.toggle("on", on);
      });
    }

    let running = false;
    const clock = new THREE.Clock();
    const loop = () => {
      if (!running) return;
      const dt = clock.getDelta();
      render(clock.elapsedTime, dt);
      requestAnimationFrame(loop);
    };

    new ResizeObserver(() => {
      const { clientWidth: w, clientHeight: h } = canvas;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      // encuadre: el grafo mide ≈12 de ancho y ≈8.5 de alto; la cámara se aleja lo justo para que quepa en ambos ejes
      camera.position.z = Math.max(12.4, 12.5 / (0.728 * camera.aspect));
      const fog = scene.fog as THREE.Fog;
      fog.near = camera.position.z - 3;
      fog.far = camera.position.z + 6;
      camera.updateProjectionMatrix();
      if (!running) render(clock.elapsedTime, 0); // primer cuadro (y cada cambio de tamaño) aunque la animación no esté corriendo
    }).observe(canvas);

    new IntersectionObserver(([entry]) => {
      running = entry.isIntersecting && !reduce;
      if (running) {
        clock.getDelta();
        loop();
      }
    }).observe(canvas);

    applyColors();
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyColors);
    new MutationObserver(applyColors).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
