---
// Precios en dólares, pensados para emprendedores y pequeñas empresas
const plans = [
  { name: "Inicial", price: "$150", per: "USD por proyecto", cta: "Empezar con Inicial",
    features: ["1 flujo de automatización", "Hasta 3 integraciones", "Documentación del flujo", "15 días de soporte"] },
  { name: "Negocio", price: "$450", per: "USD por proyecto", cta: "Elegir Negocio", featured: true,
    features: ["Hasta 5 flujos con n8n", "Chatbot para WhatsApp", "Dashboard de reportes", "Capacitación del equipo", "30 días de soporte"] },
  { name: "A medida", price: "Desde $900", per: "USD", cta: "Solicitar cotización",
    features: ["Software personalizado", "Integraciones complejas", "Asistentes virtuales a medida", "Cotización según alcance"] },
];
---
<section id="planes">
  <div class="wrap">
    <div class="plans-head">
      <div>
        <span class="label">Planes</span>
        <h2>Elige un punto de partida</h2>
      </div>
      <p>Mantenimiento mensual opcional desde $40 USD. El hosting y las suscripciones de otras apps (si las necesitas) se pagan aparte.</p>
    </div>
    <div class="plans">
      {plans.map((p) => (
        <div class:list={["plan", { featured: p.featured }]}>
          <div class="plan-top"><h3>{p.name}</h3>{p.featured && <span class="badge">Recomendado</span>}</div>
          <div class="price">{p.price} {p.per && <small>{p.per}</small>}</div>
          <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          <a href={`/contacto?plan=${encodeURIComponent(p.name)}`} class:list={["btn", p.featured ? "btn-primary" : "btn-secondary"]}>{p.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>
