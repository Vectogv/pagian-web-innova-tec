---
// Antes / ahora: cada tarea que hoy se hace a mano, frente a lo que pasa cuando el flujo la hace sola
const rows = [
  { manual: "Revisas WhatsApp varias veces al día para ver si escribió un cliente.",
    auto: "Cada mensaje se atiende al instante", tool: "WhatsApp" },
  { manual: "Copias nombre, teléfono y pedido a una hoja de Excel.",
    auto: "Los datos del cliente se guardan solos", tool: "Google Sheets" },
  { manual: "Reenvías el contacto a ventas por correo o por chat.",
    auto: "Ventas recibe un resumen listo para llamar", tool: "Gmail" },
  { manual: "Los mensajes que llegan de noche esperan hasta el día siguiente.",
    auto: "El cliente recibe respuesta a cualquier hora", tool: "Respuesta automática" },
];
const check = '<path d="M5 12.5l4.2 4.2L19 7"/>';
---
<section class="transform" aria-labelledby="transform-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Antes y ahora</span>
      <h2 id="transform-title">Así cambia un día de trabajo</h2>
      <p class="muted">Las mismas tareas de siempre, sin que nadie tenga que hacerlas a mano.</p>
    </div>

    <div class="swap" data-animate>
      <div class="swap-head" aria-hidden="true">
        <span>Hoy, a mano</span>
        <span>Con Innova Tec</span>
      </div>
      <ol>
        {rows.map((r) => (
          <li>
            <p class="swap-before"><span class="sr-only">Hoy, a mano: </span>{r.manual}</p>
            <div class="swap-after">
              <span class="swap-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={check} /></span>
              <p><span class="sr-only">Con Innova Tec: </span><b>{r.auto}</b><small>{r.tool}</small></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="swap-result"><b>Resultado:</b> ningún cliente se queda sin respuesta y tu equipo dedica el tiempo a vender, no a copiar datos.</p>
    </div>
  </div>
</section>
