---
// Antes/después como un diff de código: en rojo (-) el trabajo manual de un día cualquiera, en verde (+) lo que hace el flujo
const rows = [
  { time: "08:00", manual: "Revisas WhatsApp varias veces al día para ver si escribió un cliente.",
    auto: "Cada mensaje se detecta al instante", tool: "WhatsApp" },
  { time: "10:30", manual: "Copias nombre, teléfono y pedido a una hoja de Excel.",
    auto: "Los datos se guardan solos", tool: "Google Sheets" },
  { time: "15:00", manual: "Reenvías el contacto a ventas por correo o por chat.",
    auto: "Ventas recibe un resumen del cliente", tool: "Gmail" },
  { time: "22:00", manual: "Los mensajes que llegan de noche esperan hasta el día siguiente.",
    auto: "El cliente recibe respuesta a cualquier hora", tool: "Respuesta automática" },
];
---
<section class="transform" aria-labelledby="transform-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="path-tag">innova-tec / <b>antes-y-despues</b></span>
      <h2 id="transform-title">Así cambia un día de trabajo</h2>
      <p class="muted">Lo que hoy haces a mano, comparado línea por línea con lo que hace el flujo. Horas de ejemplo.</p>
    </div>

    <div class="diff" data-animate>
      <div class="diff-bar">
        <span>un-dia-de-trabajo.diff</span>
        <span><em class="del">−4 tareas manuales</em> <em class="add">+4 automáticas</em></span>
      </div>
      <ol class="diff-rows">
        {rows.map((r, i) => (
          <li>
            <div class="diff-del">
              <span class="ln" aria-hidden="true">{i + 1}</span>
              <span class="sign" aria-hidden="true">−</span>
              <p><span class="sr-only">Hoy, a mano: </span><time>{r.time}</time> {r.manual}</p>
            </div>
            <div class="diff-add">
              <span class="ln" aria-hidden="true">{i + 1}</span>
              <span class="sign" aria-hidden="true">+</span>
              <p><span class="sr-only">Con automatización: </span><b>{r.auto}</b> <small>{r.tool}</small></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="diff-result"><span aria-hidden="true">@@</span> Resultado: cada cliente atendido, a cualquier hora. Ventas recibe cada contacto en el momento en que escribe. <span aria-hidden="true">@@</span></p>
    </div>
  </div>
</section>
