---
const tools = ["WhatsApp", "Gmail", "Google Sheets", "Google Calendar", "Excel", "HubSpot", "Shopify", "WooCommerce", "Notion", "Slack", "Telegram", "PostgreSQL", "Stripe"];
---
<section class="tools" aria-label="Herramientas que conectamos">
  <div class="wrap">
    <p>
      Trabajamos con lo que ya usas:{" "}
      {tools.map((t, i) => <><b>{t}</b>{i < tools.length - 1 ? ", " : " "}</>)}
      y cualquier otra app que tenga API.
    </p>
  </div>
</section>
