---
import { serviceGroups } from "../data/services.js";
---
<nav class="fronts-nav" aria-label="Frentes de servicio">
  <div class="wrap">
    <span class="label">Ir a</span>
    {serviceGroups.map((g) => <a href={`#${g.id}`}>{g.title}<small>{g.items.length}</small></a>)}
  </div>
</nav>

<section class="fronts">
  <div class="wrap">
    {serviceGroups.map((g, i) => (
      <div class="front" id={g.id}>
        <div class="front-head">
          <span class="front-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h2>{g.title}</h2>
          <p>{g.lead}</p>
        </div>
        <ul>
          {g.items.map(([name, desc]) => (
            <li>
              <a href={`/contacto?servicio=${encodeURIComponent(name)}`}>
                <b>{name}</b><span>{desc}</span><i aria-hidden="true">Cotizar →</i>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
